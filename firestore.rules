rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isInOrg(oid) {
    	return request.auth != null && ((
        request.auth.token.orgIds != null &&
        oid in request.auth.token.orgIds) ||
        // Remove me after deployment
        oid == ("personal_" + request.auth.uid));
    }
  
    match /profiles/{profile} {
    	allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /scenes/{scene} {
    	allow read: if true;
      allow write: if request.auth != null;
    }

    match /jobs/{job} {
    	allow read: if true;
      allow write: if request.auth != null;
    }

    match /results/{result} {
    	allow read: if true;
      allow write: if request.auth != null;
    }

	  match /cameras/{camera} {
      allow read, delete: if isInOrg(resource.data.oid);
      allow create: if isInOrg(request.resource.data.oid);
      allow update: if isInOrg(request.resource.data.oid) && isInOrg(resource.data.oid);
    }
    
    match /locations/{location} {
      allow read, delete: if isInOrg(resource.data.oid);
      allow create: if isInOrg(request.resource.data.oid);
      allow update: if isInOrg(request.resource.data.oid) && isInOrg(resource.data.oid);
    }
    
    match /videos/{video} {
    	allow read: if true;
      allow write: if false;
    }

    match /summaries/{summary} {
    	allow read: if true;
      allow write: if request.auth != null;    
    }

    match /events/{summary} {
      allow read: if true;
      allow write: if request.auth != null;    
    }

    match /annotations/{annotation} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chunks/{chunk} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /messages/{message} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /conversations/{conversation} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /webhooks/{webhook} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /organizations/{orgId} {
      // Only members can read
      allow read: if request.auth != null 
        && (resource.data.members.hasAny([request.auth.uid])
        || resource.data.owners.hasAny([request.auth.uid])
        || resource.data.uid == request.auth.uid);

      // Authenticated users can create if they set themselves as owner and member
      allow create: if request.auth != null
        && request.resource.data.owners.hasAny([request.auth.uid])
        && request.resource.data.members.hasAny([request.auth.uid]);

      // Only owners can update or delete
      allow update, delete: if request.auth != null
        && resource.data.owners.hasAny([request.auth.uid]);
    }

    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && uid == request.auth.uid;
    }
    
    match /files/{fileId} {
      allow read, delete: if isInOrg(resource.data.oid);
      allow create: if isInOrg(request.resource.data.oid);
      allow update: if isInOrg(request.resource.data.oid) && isInOrg(resource.data.oid);
    }
    
    match /applications/{application} {
      allow read, delete: if isInOrg(resource.data.oid);
      allow create: if isInOrg(request.resource.data.oid);
      allow update: if isInOrg(request.resource.data.oid) && isInOrg(resource.data.oid);
		}

    match /api_keys/{application} {
      allow read, delete: if isInOrg(resource.data.oid);
    }

    // Credit balance per org. Server-written only (Cloud Functions use the
    // admin SDK and bypass rules). Any member of the org can read.
    match /credit_balances/{oid} {
      allow read: if isInOrg(oid);
      allow write: if false;
    }

    // Append-only ledger of credit purchases, grants, and usage debits.
    // Server-written only. Read by any member; UI gates owner-only views.
    match /credit_ledger/{id} {
      allow read: if isInOrg(resource.data.oid);
      allow write: if false;
    }

    // Stripe event idempotency log — server-only.
    match /stripe_events/{id} {
      allow read, write: if false;
    }

  }
}
